<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The whole UI is drawn by Compose; this theme only hides the action bar
         and colours the window while the app starts. -->
    <style name="Theme.Kalimat" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_sky</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
